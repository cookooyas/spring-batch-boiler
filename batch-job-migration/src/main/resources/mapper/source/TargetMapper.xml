<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="UserMapper">
    <insert id="insertUser" parameterType="map">
        INSERT INTO USERS (
            id, 
            name, 
            email,
            reg_date
        ) VALUES (
            #{id}, 
            #{name}, 
            #{email},
            SYSDATE
        )
    </insert>
</mapper>